# Copier ce fichier en .env et changer les mots de passe : cp .env.example .env

# Version de l'image glpi/glpi (11.0, 11.0.11, 10.0, latest...)
GLPI_VERSION=11.0
# Port HTTP exposé sur l'hôte
GLPI_HTTP_PORT=8080
TZ=Europe/Paris

# Base de données (les 5 variables GLPI_DB_* sont requises pour l'auto-installation)
GLPI_DB_HOST=db
GLPI_DB_PORT=3306
GLPI_DB_NAME=glpi
GLPI_DB_USER=glpi
GLPI_DB_PASSWORD=changeme_glpi
DB_ROOT_PASSWORD=changeme_root

# Installation / mise à jour automatiques du schéma
GLPI_SKIP_AUTOINSTALL=false
GLPI_SKIP_AUTOUPDATE=false
# Tâches cron GLPI exécutées dans le conteneur (1 = activé)
GLPI_CRONTAB_ENABLED=1
