# Variables du stack GLPI. Copier en stack.env (non versionné) ou les saisir
# dans Portainer → Stacks → Environment variables.
# Générer des mots de passe : openssl rand -hex 16

GLPI_DB_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme

# Optionnel
GLPI_VERSION=latest
GLPI_HTTP_PORT=9461
GLPI_DATA_DIR=/volume2/docker/glpi
